<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ABDU Manager</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            color-scheme: dark;
            --bg: #0d0f0e;
            --surface: #151917;
            --surface-2: #1b211e;
            --surface-3: #232b26;
            --line: rgba(255,255,255,.07);
            --text: #f3f7f4;
            --muted: #89958d;
            --green: #00e676;
            --green-soft: rgba(0,230,118,.11);
            --radius: 18px;
        }
        * { box-sizing: border-box; }
        body {
            background: radial-gradient(ellipse at 50% -18%, rgba(0,230,118,.09), transparent 42%), var(--bg);
            color: var(--text); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            margin: 0; padding: 22px 16px 34px; display: flex; flex-direction: column; align-items: center;
            min-height: 100vh; -webkit-font-smoothing: antialiased;
        }
        button, input { font: inherit; }
        .login-box { background: var(--surface); border: 1px solid var(--line); padding: 24px; border-radius: 20px; width: 100%; max-width: 360px; display: flex; flex-direction: column; gap: 14px; margin-top: 9vh; box-shadow: 0 18px 55px rgba(0,0,0,.28); }
        .login-box h2 { text-align: center; margin: 0 0 8px; color: var(--green); letter-spacing: -.4px; }
        .login-box input { padding: 13px 14px; border-radius: 11px; border: 1px solid var(--line); background: #101411; color: var(--text); font-size: 16px; outline: none; }
        .login-box input:focus { border-color: rgba(0,230,118,.55); box-shadow: 0 0 0 3px rgba(0,230,118,.08); }
        .login-box button { padding: 13px; border-radius: 11px; border: none; background: var(--green); color: #07130c; font-weight: 800; font-size: 15px; cursor: pointer; }
        .login-box button:disabled { background: #333; color: #777; cursor: not-allowed; }
        #login-status { color: var(--muted); font-size: 12px; text-align: center; min-height: 16px; }

        #main-screen { display: none; width: 100%; max-width: 760px; --accent: #00e676; --accent-soft: rgba(0,230,118,.11); --accent-line: rgba(0,230,118,.22); --accent-glow: rgba(0,230,118,.14); --accent-ink: #06140b; }
        #main-screen[data-theme="milk"] { --accent: #48a9ff; --accent-soft: rgba(72,169,255,.12); --accent-line: rgba(72,169,255,.24); --accent-glow: rgba(72,169,255,.15); --accent-ink: #071522; }
        #main-screen[data-theme="tasks"] { --accent: #ff9b42; --accent-soft: rgba(255,155,66,.12); --accent-line: rgba(255,155,66,.24); --accent-glow: rgba(255,155,66,.15); --accent-ink: #211307; }
        #main-screen[data-theme="graph-milk"] { --accent: #48a9ff; --accent-soft: rgba(72,169,255,.12); --accent-line: rgba(72,169,255,.24); --accent-glow: rgba(72,169,255,.15); --accent-ink: #071522; }
        #main-screen[data-theme="graph-tasks"] { --accent: #ff9b42; --accent-soft: rgba(255,155,66,.12); --accent-line: rgba(255,155,66,.24); --accent-glow: rgba(255,155,66,.15); --accent-ink: #211307; }
        .top-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 2px 2px 22px; }
        .brand { display: flex; flex-direction: column; gap: 4px; }
        .title { font-size: 23px; font-weight: 900; color: var(--text); letter-spacing: -.8px; line-height: 1.1; }
        .subtitle { font-size: 10px; font-weight: 800; color: var(--green); text-transform: uppercase; letter-spacing: 1.8px; }

        .tabs { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 5px; background: rgba(21,25,23,.92); border: 1px solid var(--line); border-radius: 15px; padding: 5px; margin-bottom: 18px; width: 100%; }
        .tab { display: flex; align-items: center; justify-content: center; gap: 7px; min-width: 0; padding: 12px 8px; text-align: center; font-size: 12px; font-weight: 750; color: #87918a; cursor: pointer; border-radius: 11px; transition: background .18s ease, color .18s ease, transform .18s ease; white-space: nowrap; user-select: none; }
        .tab:hover { color: var(--text); background: rgba(255,255,255,.035); }
        .tab.active { color: var(--accent-ink); background: var(--accent); box-shadow: 0 5px 16px var(--accent-glow); }
        .section { animation: sectionIn .22s ease both; }
        @keyframes sectionIn { from { opacity: .55; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
        .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin: 4px 2px 14px; }
        .section-heading h2 { margin: 0; font-size: 18px; font-weight: 850; letter-spacing: -.45px; }
        .section-heading p { margin: 5px 0 0; color: var(--muted); font-size: 11px; line-height: 1.4; }
        .section-icon { width: 38px; height: 38px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 12px; background: var(--accent-soft); border: 1px solid var(--accent-line); font-size: 18px; }
        .periods { display: flex; gap: 4px; background: #121613; border: 1px solid var(--line); border-radius: 12px; padding: 4px; margin-bottom: 14px; width: 100%; }
        .period { flex: 1; padding: 9px 5px; text-align: center; font-size: 11px; font-weight: 750; color: #778179; cursor: pointer; border-radius: 8px; transition: .18s ease; white-space: nowrap; user-select: none; }
        .period:hover { color: var(--text); }
        .period.active { color: var(--accent); background: var(--surface-3); box-shadow: inset 0 0 0 1px var(--accent-line); }

        .grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 11px; width: 100%; margin-bottom: 18px; align-items: stretch; }
        .grid .card:last-child:nth-child(odd) { grid-column: 1 / -1; width: calc(50% - 5.5px); justify-self: center; }
        .card { min-width: 0; display: flex; flex-direction: column; background: linear-gradient(145deg, #1a211d, #151917 72%); padding: 14px; border-radius: 16px; border: 1px solid var(--line); border-top: 2px solid transparent; box-shadow: 0 8px 22px rgba(0,0,0,.13); transition: transform .18s ease, border-color .18s ease; }
        .card:hover { transform: translateY(-2px); border-color: rgba(255,255,255,.12); }
        .card-top { display: flex; align-items: center; margin-bottom: 12px; min-width: 0; }
        .avatar-box { width: 46px; height: 46px; border-radius: 50%; overflow: hidden; border: 2px solid; margin-right: 11px; flex-shrink: 0; background: #252d28; }
        .avatar-box img { width: 100%; height: 100%; object-fit: cover; }
        .info { display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
        .name { font-size: 13px; font-weight: 850; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 4px; }
        .val { font-size: 12px; font-weight: 750; color: #a1ada5; line-height: 1.45; }
        .rank-label { display: inline-flex; align-items: center; gap: 5px; color: #7f8b83; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .8px; margin-bottom: 7px; }
        .compliment-box { position: relative; font-size: 10px; font-weight: 600; color: #aab4ad; background: rgba(255,255,255,.035); border-radius: 0 8px 8px 0; border-left: 2px solid; padding: 8px 20px 8px 9px; text-align: left; width: 100%; font-style: italic; line-height: 1.35; overflow-wrap: anywhere; }
        .quote-mark { position: absolute; top: 1px; right: 7px; font-size: 17px; font-weight: 900; line-height: 1; font-family: Georgia, serif; opacity: .75; }
        .card.top-1 { background: linear-gradient(145deg, rgba(255,215,0,.075), #171c19 65%); border-top-color: #d8b84d; }
        .card.top-2 { background: linear-gradient(145deg, rgba(192,192,192,.065), #171c19 65%); border-top-color: #89949b; }
        .card.top-3 { background: linear-gradient(145deg, rgba(205,127,50,.075), #171c19 65%); border-top-color: #a87549; }
        .task-card {
            position: relative; gap: 13px; min-height: 0; padding: 15px;
            justify-content: space-between; overflow: hidden;
            background: linear-gradient(145deg, #1b241f, #141916 78%);
            animation: cardIn .42s cubic-bezier(.2,.75,.25,1) both;
        }
        .task-card::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 3px; background: linear-gradient(180deg, #ff9b42, rgba(255,155,66,.08)); }
        .task-head { display: flex; align-items: center; gap: 11px; min-width: 0; }
        .task-emoji { display: grid; place-items: center; width: 48px; height: 48px; flex: 0 0 auto; border-radius: 14px; background: rgba(255,155,66,.10); border: 1px solid rgba(255,155,66,.18); font-size: 25px; }
        .task-title-wrap { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
        .task-name { color: var(--text); font-size: 13px; font-weight: 850; letter-spacing: -.15px; }
        .task-index { color: #758279; font-size: 9px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; }
        .task-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .task-metric { background: rgba(0,0,0,.2); border: 1px solid rgba(255,255,255,.035); border-radius: 11px; padding: 10px; min-width: 0; }
        .task-metric span { display: block; color: #87948b; font-size: 9px; font-weight: 750; margin-bottom: 6px; }
        .task-metric strong { display: block; color: var(--text); font-size: clamp(12px, 2.8vw, 15px); font-weight: 900; letter-spacing: -.25px; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
        .task-metric.money strong { color: #ffb36e; }
        .task-card:nth-child(2n) { animation-delay: .045s; }
        .task-card:nth-child(3n) { animation-delay: .09s; }
        .empty-state { grid-column: 1 / -1; padding: 28px 16px; text-align: center; border: 1px dashed rgba(255,255,255,.1); border-radius: 15px; color: var(--muted); font-size: 12px; background: rgba(255,255,255,.015); }

        .calendar-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; padding: 0 12px 8px; color: var(--muted); text-align: center; font-size: 10px; font-weight: 800; letter-spacing: .4px; }
        .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; padding: 12px; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; }
        .calendar-cell { aspect-ratio: 1/1; min-width: 0; background: #202823; border-radius: 8px; position: relative; overflow: hidden; }
        .calendar-cell .day-number { position: absolute; top: 5px; left: 6px; font-size: 10px; font-weight: 800; color: rgba(255,255,255,.68); }
        .calendar-cell .day-value { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding-top: 6px; font-size: clamp(10px, 2.7vw, 15px); font-weight: 900; color: #fff; text-align: center; overflow: hidden; }
        .calendar-cell.empty { background: transparent; }
        .calendar-cell.empty .day-number, .calendar-cell.empty .day-value { display: none; }
        .calendar-cell.c-gray { background: #202622; color: #68736b; }
        .calendar-cell.c-red { background: #ef5350; color: #fff; }
        .calendar-cell.c-orange { background: #ff9100; color: #fff; }
        .calendar-cell.c-yellow { background: #ffd600; color: #101510; }
        .calendar-cell.c-green { background: #00e676; color: #101510; }
        .calendar-cell.c-yellow .day-number, .calendar-cell.c-yellow .day-value,
        .calendar-cell.c-green .day-number, .calendar-cell.c-green .day-value { color: #101510; }
        .calendar-cell.c-gray .day-value { color: #aab4ad; }
        #calendar-title { text-align: center; font-size: 14px; font-weight: 800; color: #dbe5de; margin-bottom: 12px !important; }
        .graph-types { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 7px; margin-bottom: 12px; }
        .graph-type { min-width: 0; border: 1px solid var(--line); border-radius: 11px; padding: 11px 6px; background: var(--surface); color: var(--muted); font-size: 11px; font-weight: 800; cursor: pointer; transition: .18s ease; }
        .graph-type.active { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent-line); }
        .chart-container { width: 100%; height: 310px; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 13px 10px 10px; box-shadow: 0 8px 22px rgba(0,0,0,.12); overflow: hidden; }
        .chart-container canvas { display: block; width: 100% !important; height: 100% !important; }
        .chart-data-list { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 7px; margin-top: 10px; }
        .chart-data-item { display: flex; justify-content: space-between; align-items: center; gap: 6px; min-width: 0; padding: 8px 9px; border-radius: 9px; background: var(--surface); border: 1px solid var(--line); font-size: 10px; }
        .chart-data-item span { color: var(--muted); white-space: nowrap; }
        .chart-data-item strong { color: var(--accent); font-size: 11px; font-variant-numeric: tabular-nums; }
        .calendar-cell:not(.empty) { animation: cellIn .32s ease both; }
        .calendar-cell:nth-child(7n + 1) { animation-delay: .02s; }
        .calendar-cell:nth-child(7n + 2) { animation-delay: .04s; }
        .calendar-cell:nth-child(7n + 3) { animation-delay: .06s; }
        .card { animation: cardIn .38s cubic-bezier(.2,.75,.25,1) both; }
        .grid .card:nth-child(2n) { animation-delay: .045s; }
        .grid .card:nth-child(3n) { animation-delay: .09s; }
        @keyframes cardIn { from { opacity: 0; transform: translateY(9px) scale(.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes cellIn { from { opacity: 0; transform: scale(.88); } to { opacity: 1; transform: scale(1); } }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; }
        }
        .footer { margin-top: 22px; padding-top: 16px; border-top: 1px solid var(--line); width: 100%; font-size: 11px; font-weight: 650; color: #7c8980; text-align: center; }
        #logout-btn { display: block; margin: 14px auto 0; padding: 9px 17px; background: #1a211d; color: #9aa69e; border: 1px solid var(--line); border-radius: 10px; cursor: pointer; font-size: 11px; font-weight: 750; }
        #logout-btn:hover { color: var(--text); background: #222b25; }
        @media (max-width: 520px) {
            body { padding: 17px 12px 26px; }
            .top-bar { margin-bottom: 17px; }
            .title { font-size: 21px; }
            .tabs { gap: 3px; padding: 4px; border-radius: 13px; }
            .tab { flex-direction: column; gap: 4px; padding: 9px 3px; font-size: 10px; }
            .section-heading h2 { font-size: 17px; }
            .grid { gap: 8px; }
            .card { padding: 11px; border-radius: 14px; }
            .avatar-box { width: 40px; height: 40px; margin-right: 8px; }
            .name { font-size: 12px; }
            .val { font-size: 11px; }
            .period { font-size: 10px; padding: 9px 2px; }
            .chart-container { height: 270px; padding: 10px 7px 7px; }
            .chart-data-list { grid-template-columns: repeat(2, minmax(0,1fr)); }
            .graph-type { font-size: 10px; padding: 10px 3px; }
            .task-card { padding: 12px; gap: 10px; }
            .task-emoji { width: 42px; height: 42px; font-size: 22px; }
            .task-metric { padding: 9px 8px; }
        }
        @media (max-width: 360px) {
            .tab { font-size: 9px; }
            .grid { grid-template-columns: 1fr; }
            .grid .card:last-child:nth-child(odd) { grid-column: auto; width: 100%; }
        }

        /* ABDU polish: resource cards and sign-in */
        .login-box {
            position: relative; overflow: hidden; max-width: 390px; margin: clamp(34px, 9vh, 88px) auto 0;
            padding: 30px 26px 22px; gap: 12px; border-radius: 25px;
            background: linear-gradient(155deg, rgba(25,34,29,.98), rgba(16,21,18,.98) 62%);
            border: 1px solid rgba(0,230,118,.16);
            box-shadow: 0 28px 80px rgba(0,0,0,.42), 0 0 50px rgba(0,230,118,.055);
        }
        .login-box::before { content:""; position:absolute; width:220px; height:220px; right:-105px; top:-125px; border-radius:50%; background:rgba(0,230,118,.10); filter:blur(3px); pointer-events:none; }
        .login-code-wrap { display:none; flex-direction:column; gap:10px; }
        .login-mark { position:relative; display:grid; place-items:center; width:54px; height:54px; margin:0 auto 5px; border-radius:17px; color:#06140b; font-size:17px; font-weight:950; letter-spacing:-1px; background:linear-gradient(145deg,#39f69a,#00c96a); box-shadow:0 9px 26px rgba(0,230,118,.2); }
        .login-mark i { position:absolute; width:8px; height:8px; right:8px; top:8px; border-radius:50%; background:#eafff3; box-shadow:0 0 0 3px rgba(6,20,11,.15); }
        .login-heading { text-align:center; margin-bottom:10px; }
        .login-kicker { color:var(--green); font-size:9px; font-weight:900; letter-spacing:2.2px; margin-bottom:8px; }
        .login-box h2 { color:var(--text); font-size:25px; font-weight:900; letter-spacing:-.8px; margin:0; }
        .login-heading p { color:var(--muted); font-size:12px; margin:7px 0 0; }
        .login-label { display:block; color:#aab6ae; font-size:11px; font-weight:800; letter-spacing:.2px; margin:3px 1px -5px; }
        .login-box input { width:100%; min-height:49px; padding:13px 14px; border-radius:13px; border:1px solid rgba(255,255,255,.085); background:rgba(5,10,7,.48); color:var(--text); font-size:15px; transition:border-color .2s,box-shadow .2s,background .2s; }
        .login-box input::placeholder { color:#657168; }
        .login-box input:focus { border-color:rgba(0,230,118,.62); background:#101813; box-shadow:0 0 0 4px rgba(0,230,118,.09); }
        .login-box button { min-height:49px; border-radius:13px; display:flex; align-items:center; justify-content:center; gap:10px; font-size:14px; transition:transform .18s,filter .18s,box-shadow .18s; }
        .login-box button:active { transform:scale(.985); }
        .login-primary { position:relative; color:#06140b !important; background:linear-gradient(135deg,#26ee8c,#00cf70) !important; box-shadow:0 8px 22px rgba(0,230,118,.15); }
        .login-primary b { position:absolute; right:17px; font-size:20px; font-weight:600; }
        .login-secondary { color:#06140b !important; background:linear-gradient(135deg,#26ee8c,#00cf70) !important; }
        .login-secondary span { font-size:19px; }
        #login-status { min-height:18px; margin-top:1px; font-size:11px; }
        .login-foot { display:flex; justify-content:center; align-items:center; gap:7px; padding-top:14px; margin-top:3px; border-top:1px solid rgba(255,255,255,.055); color:#718078; font-size:10px; font-weight:650; }
        .login-lock { color:var(--green); font-size:15px; }

        #grid-tasks { grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
        .task-card {
            position:relative; min-height:190px; padding:14px; gap:0; overflow:hidden;
            justify-content:flex-start; border:1px solid var(--task-accent-line);
            border-top:1px solid var(--task-accent-line);
            background:radial-gradient(circle at 100% 0%,rgba(255,155,66,.11),transparent 46%),linear-gradient(150deg,#1b211d,#131815 76%);
            animation:cardIn .38s cubic-bezier(.2,.75,.25,1) both;
        }
        .task-card::before { content:""; position:absolute; inset:0 auto 0 0; width:3px; background:linear-gradient(180deg,#ffb36e,rgba(255,155,66,.08)); }
        .task-card:hover { transform:translateY(-3px); border-color:rgba(255,155,66,.42); box-shadow:0 13px 30px rgba(0,0,0,.22),0 0 22px rgba(255,155,66,.045); }
        .task-card-top { display:flex; align-items:center; gap:10px; min-width:0; }
        .task-emoji { display:grid; place-items:center; width:43px; height:43px; flex:0 0 43px; border-radius:14px; background:rgba(255,155,66,.13); border:1px solid rgba(255,155,66,.2); font-size:23px; }
        .task-title-wrap { display:flex; flex-direction:column; gap:4px; min-width:0; }
        .task-index { color:#9a8068; font-size:8px; font-weight:900; letter-spacing:1.15px; }
        .task-name { color:#fff2e6; font-size:14px; font-weight:900; letter-spacing:-.2px; overflow-wrap:anywhere; }
        .task-kind { margin-left:auto; align-self:flex-start; padding:5px 7px; border-radius:7px; color:#ffb36e; background:rgba(255,155,66,.09); font-size:8px; font-weight:900; letter-spacing:.8px; }
        .task-main-value { display:flex; flex-direction:column; gap:2px; margin:17px 0 14px; }
        .task-main-value strong { color:#fff; font-size:clamp(21px,5vw,27px); line-height:1; font-weight:950; letter-spacing:-.8px; font-variant-numeric:tabular-nums; }
        .task-main-value span { color:#849087; font-size:10px; font-weight:650; }
        .task-card-bottom { display:flex; align-items:center; justify-content:space-between; gap:8px; padding-top:10px; margin-top:auto; border-top:1px solid rgba(255,255,255,.065); }
        .task-money-label { color:#89948c; font-size:10px; font-weight:700; }
        .task-money-value { color:#ffb36e; font-size:13px; font-weight:900; white-space:nowrap; font-variant-numeric:tabular-nums; }
        .task-money-value small { font-size:11px; }
        @media (max-width:420px) {
            .login-box { padding:26px 20px 19px; }
            #grid-tasks { gap:9px; }
            .task-card { min-height:180px; padding:12px 10px; }
            .task-emoji { width:39px; height:39px; flex-basis:39px; font-size:21px; }
            .task-name { font-size:12px; }
            .task-kind { font-size:7px; padding:4px 5px; }
            .task-main-value strong { font-size:21px; }
            .task-money-value { font-size:11px; }
        }
        @media (max-width:330px) { #grid-tasks { grid-template-columns:1fr; } .task-card { min-height:165px; } }


        /* ABDU visual refinement: clearer analytics, calendar and milk ranking */
        .chart-container {
            height: 300px; min-height: 260px; padding: 18px 14px 14px;
            border: 1px solid rgba(255,255,255,.075);
            border-radius: 20px;
            background: radial-gradient(ellipse at 50% 0%, var(--accent-soft), transparent 62%), linear-gradient(145deg,#171d19,#111613 78%);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.035), 0 14px 34px rgba(0,0,0,.18);
        }
        .chart-data-list { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 7px; margin-top: 12px; }
        .chart-data-heading { grid-column: 1/-1; display:flex; justify-content:space-between; padding: 3px 2px 5px; color:var(--muted); font-size:10px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; }
        .chart-data-item { padding: 9px 10px; min-height:38px; border-radius:11px; background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.018)); border:1px solid rgba(255,255,255,.055); }
        .chart-data-item span { font-size:10px; }
        .chart-data-item strong { font-size:12px; }
        .graph-types { gap:8px; }
        .graph-type { min-height:44px; border-radius:13px; font-size:12px; }
        .graph-type[data-kind="sales"].active { color:#06140b; background:#00e676; border-color:#00e676; }
        .graph-type[data-kind="milk"].active { color:#071522; background:#48a9ff; border-color:#48a9ff; }
        .graph-type[data-kind="tasks"].active { color:#211307; background:#ff9b42; border-color:#ff9b42; }
        .calendar-weekdays { gap:6px; padding:0 12px 10px; color:#8e9b92; font-size:10px; }
        .calendar-grid { gap:6px; padding:13px; border-radius:20px; background:linear-gradient(145deg,#171d19,#111613); border:1px solid rgba(255,255,255,.075); box-shadow:inset 0 1px 0 rgba(255,255,255,.035),0 14px 34px rgba(0,0,0,.16); }
        .calendar-cell { aspect-ratio:1/1; min-height:0; border-radius:11px; background:#202823; border:1px solid rgba(255,255,255,.035); transition:transform .18s ease,filter .18s ease; }
        .calendar-cell:not(.empty):active { transform:scale(.95); }
        .calendar-cell .day-number { top:6px; left:7px; font-size:10px; color:rgba(255,255,255,.75); }
        .calendar-cell .day-value { padding:12px 2px 0; font-size:clamp(10px,2.6vw,14px); font-weight:900; font-variant-numeric:tabular-nums; }
        .calendar-cell.c-gray { background:linear-gradient(145deg,#202823,#1a211d); }
        .calendar-cell.c-red { background:linear-gradient(145deg,#9d4847,#703332); }
        .calendar-cell.c-orange { background:linear-gradient(145deg,#b96b2a,#814719); }
        .calendar-cell.c-yellow { background:linear-gradient(145deg,#b99b36,#806a24); }
        .calendar-cell.c-green { background:linear-gradient(145deg,#00b968,#087c4a); }
        .calendar-cell.is-today { outline:2px solid var(--accent); outline-offset:2px; box-shadow:0 0 0 4px var(--accent-soft); }
        #calendar-title { display:inline-flex; margin:0 auto 14px !important; padding:9px 15px; border:1px solid var(--accent-line); border-radius:12px; background:var(--accent-soft); color:var(--text); font-size:14px; }
        #section-calendar { text-align:center; }
        .milk-card { --milk-accent:#48a9ff; position:relative; gap:13px; padding:15px; overflow:hidden; border:1px solid rgba(72,169,255,.15); background:linear-gradient(145deg,rgba(72,169,255,.12),#151b20 66%); }
        .milk-card::after { content:""; position:absolute; width:130px; height:130px; right:-65px; top:-75px; border-radius:50%; background:radial-gradient(circle,rgba(72,169,255,.13),transparent 70%); pointer-events:none; }
        .milk-card-head { display:flex; align-items:center; gap:10px; min-width:0; }
        .milk-card .avatar-box { width:44px; height:44px; margin:0; border-color:rgba(72,169,255,.65); }
        .milk-rank { display:grid; place-items:center; min-width:30px; height:30px; padding:0 7px; border-radius:10px; color:#9bd0ff; background:rgba(72,169,255,.12); border:1px solid rgba(72,169,255,.2); font-size:11px; font-weight:900; }
        .milk-rank-1 .milk-rank { color:#081725; background:#8bcaff; border-color:#8bcaff; }
        .milk-caption { color:#7799b6; font-size:8px; font-weight:850; letter-spacing:1px; }
        .milk-score { display:flex; align-items:baseline; gap:7px; padding-left:40px; }
        .milk-score strong { color:#8ccaff; font-size:clamp(25px,6vw,32px); line-height:1; font-weight:950; letter-spacing:-1px; font-variant-numeric:tabular-nums; }
        .milk-score span { color:#9baebd; font-size:11px; font-weight:750; }
        .milk-progress { height:5px; margin-left:40px; border-radius:99px; overflow:hidden; background:rgba(72,169,255,.10); }
        .milk-progress i { display:block; height:100%; border-radius:inherit; background:linear-gradient(90deg,#2789df,#75c1ff); box-shadow:0 0 12px rgba(72,169,255,.35); }
        @media(max-width:480px) {
            .chart-container { height:270px; padding:13px 8px 10px; }
            .chart-data-list { grid-template-columns:repeat(2,minmax(0,1fr)); }
            .calendar-grid { gap:4px; padding:9px; }
            .calendar-cell { border-radius:8px; }
            .calendar-cell .day-number { top:4px; left:5px; font-size:9px; }
            .calendar-cell .day-value { font-size:clamp(9px,2.7vw,12px); }
        }

    
        /* Refined genetics, milk and spreadsheet-style activity log */
        .gen-card {
            position:relative; overflow:hidden; padding:17px; gap:13px;
            border:1px solid rgba(0,230,118,.18);
            background:linear-gradient(145deg,rgba(0,230,118,.105),rgba(20,27,23,.98) 58%);
        }
        .gen-card::before { content:""; position:absolute; width:170px; height:170px; right:-90px; top:-105px; border-radius:50%; background:rgba(0,230,118,.10); filter:blur(2px); pointer-events:none; }
        .gen-head { display:flex; align-items:center; gap:11px; position:relative; z-index:1; }
        .gen-head .avatar-box { width:48px; height:48px; flex:0 0 48px; border:1px solid rgba(0,230,118,.65); }
        .gen-rank { width:29px; height:29px; display:grid; place-items:center; border-radius:9px; background:rgba(0,230,118,.13); color:#73ffb4; font-size:11px; font-weight:900; }
        .gen-rank.first { background:linear-gradient(135deg,#b7ffd7,#00e676); color:#062313; }
        .gen-user { min-width:0; flex:1; }
        .gen-user .name { font-size:15px; font-weight:850; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .gen-user small { display:block; margin-top:3px; color:#78a58b; font-size:9px; letter-spacing:1.1px; font-weight:850; }
        .gen-value { display:flex; align-items:baseline; gap:7px; padding-left:40px; position:relative; z-index:1; }
        .gen-value strong { color:#65f5a8; font-size:clamp(27px,7vw,35px); line-height:1; font-weight:950; letter-spacing:-1.2px; font-variant-numeric:tabular-nums; }
        .gen-value span { color:#9eb6a7; font-size:11px; font-weight:750; }
        .gen-quote { position:relative; padding:11px 42px 11px 13px; min-height:43px; border:1px solid rgba(0,230,118,.13); border-left:3px solid #00e676; border-radius:12px; background:rgba(0,0,0,.18); color:#c4d7cb; font-size:12px; line-height:1.45; }
        .gen-quote button { position:absolute; right:7px; top:50%; transform:translateY(-50%); border:1px solid rgba(0,230,118,.24); background:rgba(0,230,118,.10); color:#8affbd; border-radius:8px; padding:6px 8px; font-size:10px; font-weight:800; cursor:pointer; }
        .milk-card { padding:16px; border-radius:18px; background:linear-gradient(145deg,rgba(72,169,255,.09),#151c23 68%); border:1px solid rgba(72,169,255,.18); gap:12px; }
        .milk-card-head { display:flex; align-items:center; gap:11px; }
        .milk-card .avatar-box { width:46px; height:46px; margin:0; border:1px solid rgba(72,169,255,.55); }
        .milk-rank { display:grid; place-items:center; min-width:29px; height:29px; border-radius:9px; background:rgba(72,169,255,.13); border:1px solid rgba(72,169,255,.22); color:#9bd0ff; font-size:11px; font-weight:900; }
        .milk-rank-1 .milk-rank { color:#061a2b; background:#8bcaff; border-color:#8bcaff; }
        .milk-caption { color:#7fa9cc; font-size:9px; font-weight:850; letter-spacing:1px; }
        .milk-score { display:flex; align-items:baseline; gap:7px; padding-left:40px; }
        .milk-score strong { color:#8ccaff; font-size:clamp(27px,7vw,35px); line-height:1; font-weight:950; font-variant-numeric:tabular-nums; }
        .milk-score span { color:#a6bdcf; font-size:11px; font-weight:750; }
        .milk-progress { height:6px; margin-left:40px; border-radius:99px; overflow:hidden; background:rgba(72,169,255,.10); }
        .milk-progress i { display:block; height:100%; border-radius:inherit; background:linear-gradient(90deg,#2789df,#75c1ff); box-shadow:0 0 12px rgba(72,169,255,.30); }
        .log-toolbar { display:flex; gap:8px; flex-wrap:wrap; margin:12px 0; }
        .log-control { min-height:38px; border:1px solid var(--line); border-radius:11px; padding:0 11px; color:var(--text); background:var(--surface-2); font:inherit; font-size:12px; outline:none; }
        .log-summary { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin:12px 0; }
        .log-kpi { padding:12px; border:1px solid var(--line); border-radius:13px; background:var(--surface); min-width:0; }
        .log-kpi span { display:block; color:var(--muted); font-size:10px; font-weight:750; }
        .log-kpi strong { display:block; margin-top:5px; font-size:18px; font-weight:900; font-variant-numeric:tabular-nums; }
        .log-table-wrap { overflow:auto; border:1px solid var(--line); border-radius:14px; background:#111613; -webkit-overflow-scrolling:touch; }
        .log-table { width:100%; min-width:690px; border-collapse:collapse; font-size:11px; }
        .log-table th { position:sticky; top:0; z-index:1; padding:11px 10px; text-align:left; color:#a5b4aa; background:#1b241e; font-size:9px; letter-spacing:.8px; text-transform:uppercase; white-space:nowrap; }
        .log-table td { padding:10px; border-top:1px solid rgba(255,255,255,.045); color:#dce7df; white-space:nowrap; }
        .log-table tr:hover td { background:rgba(255,255,255,.025); }
        .log-type { display:inline-flex; align-items:center; gap:5px; padding:4px 7px; border-radius:7px; font-weight:850; }
        .log-type.sales { color:#76f5ae; background:rgba(0,230,118,.10); }
        .log-type.milk { color:#8ccaff; background:rgba(72,169,255,.11); }
        .log-type.tasks { color:#ffbd7e; background:rgba(255,155,66,.12); }
        .log-positive { color:#75f2a8 !important; font-weight:850; }
        .log-empty { padding:22px; text-align:center; color:var(--muted); font-size:12px; }
        @media(max-width:420px) { .log-summary { gap:6px; } .log-kpi { padding:9px; } .log-kpi strong { font-size:15px; } }

    
        /* Mobile layout: give ranking cards room and keep controls out of text */
        @media (max-width: 600px) {
            body { padding: 16px 12px 30px; }
            #main-screen { width: 100%; max-width: 100%; }
            .tabs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .tab {
                flex-direction: row;
                justify-content: center;
                gap: 5px;
                min-height: 42px;
                padding: 9px 5px;
                font-size: 11px;
            }
            .grid, #grid-tasks {
                grid-template-columns: minmax(0, 1fr) !important;
                gap: 12px;
                align-items: stretch;
            }
            .grid .card:last-child:nth-child(odd) {
                grid-column: auto;
                width: 100%;
                justify-self: stretch;
            }
            .card, .gen-card, .milk-card {
                width: 100%;
                min-width: 0;
                padding: 16px;
                border-radius: 17px;
            }
            .gen-card, .milk-card { gap: 12px; }
            .gen-head, .milk-card-head { gap: 10px; }
            .gen-head .avatar-box { width: 44px; height: 44px; flex-basis: 44px; }
            .gen-user { flex: 1 1 0; min-width: 0; }
            .gen-user .name {
                white-space: normal;
                overflow: visible;
                text-overflow: clip;
                overflow-wrap: anywhere;
                line-height: 1.25;
                font-size: 14px;
            }
            .gen-user small {
                white-space: normal;
                overflow-wrap: anywhere;
                letter-spacing: .7px;
                line-height: 1.35;
                font-size: 9px;
            }
            .gen-value { padding-left: 0; margin: 2px 0 1px; }
            .gen-quote {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                gap: 9px;
                padding: 12px;
                min-height: 0;
                font-size: 13px;
                line-height: 1.5;
                overflow-wrap: anywhere;
            }
            .gen-quote .quote-text { width: 100%; }
            .gen-quote button {
                position: static;
                transform: none;
                align-self: flex-start;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 34px;
                margin: 0;
                padding: 7px 12px;
                font-size: 11px;
            }
            .milk-score { padding-left: 0; }
            .milk-progress { margin-left: 0; }
            .task-card { min-height: 0; padding: 15px; }
            .log-toolbar { display: grid; grid-template-columns: 1fr 1fr; }
            .log-control { min-width: 0; width: 100%; }
            #log-search { grid-column: 1 / -1; }
            .chart-container { height: 260px; }
        }
        @media (max-width: 360px) {
            body { padding-left: 9px; padding-right: 9px; }
            .tab { font-size: 10px; gap: 3px; }
            .section-heading { align-items: center; }
            .section-heading p { max-width: 245px; }
            .period { font-size: 9px; }
            .gen-card, .milk-card { padding: 13px; }
        }



        /* ABDU Manager — responsive visual system v2 (task cards intentionally untouched) */
        :root {
            --bg: #0b100d;
            --surface: #121a15;
            --surface-2: #17221b;
            --surface-3: #1d2a21;
            --line: rgba(205,238,215,.09);
            --muted: #91a397;
            --green: #42e995;
            --green-soft: rgba(66,233,149,.12);
        }
        body {
            width: 100%; min-height: 100svh; padding: clamp(14px, 3vw, 34px) clamp(12px, 3vw, 28px) 36px;
            background:
              radial-gradient(ellipse at 12% 0%, rgba(52,190,115,.12), transparent 34%),
              radial-gradient(ellipse at 92% 12%, rgba(62,135,95,.09), transparent 30%),
              #0b100d;
        }
        #main-screen { max-width: 1120px; }
        .top-bar {
            position: relative; padding: 17px 19px; margin: 0 0 15px; border-radius: 20px;
            border: 1px solid rgba(117,210,151,.15);
            background: linear-gradient(115deg, rgba(24,48,34,.96), rgba(17,27,21,.96) 58%, rgba(20,35,26,.96));
            box-shadow: 0 14px 36px rgba(0,0,0,.18), inset 0 1px rgba(255,255,255,.035);
            overflow: hidden;
        }
        .top-bar::after { content:""; position:absolute; width:210px; height:210px; right:-80px; top:-145px; border-radius:50%; background:rgba(66,233,149,.12); filter:blur(3px); pointer-events:none; }
        .brand { position:relative; z-index:1; gap:6px; }
        .title { font-size:clamp(21px,3vw,27px); letter-spacing:-1.05px; }
        .subtitle { color:#70dca0; font-size:9px; letter-spacing:2.1px; }
        .tabs {
            position:sticky; top:8px; z-index:20; grid-template-columns:repeat(6,minmax(0,1fr));
            gap:6px; padding:6px; margin:0 0 22px; border-radius:17px;
            background:rgba(17,25,20,.92); border:1px solid rgba(205,238,215,.11);
            box-shadow:0 12px 28px rgba(0,0,0,.2); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px);
        }
        .tab { min-height:44px; padding:10px 7px; border-radius:12px; font-size:clamp(10px,1.1vw,12px); gap:6px; }
        .tab.active { box-shadow:0 5px 16px var(--accent-glow), inset 0 1px rgba(255,255,255,.18); }
        .section-heading {
            position:relative; align-items:center; min-height:92px; padding:19px 20px; margin:0 0 17px;
            border:1px solid var(--accent-line); border-radius:19px; overflow:hidden;
            background:linear-gradient(112deg,var(--accent-soft),rgba(19,28,22,.94) 48%,rgba(19,28,22,.98));
            box-shadow:0 12px 28px rgba(0,0,0,.14), inset 0 1px rgba(255,255,255,.035);
        }
        .section-heading::before { content:""; position:absolute; left:0; top:17px; bottom:17px; width:3px; border-radius:0 4px 4px 0; background:var(--accent); box-shadow:0 0 18px var(--accent-glow); }
        .section-heading::after { content:""; position:absolute; width:150px; height:150px; right:-52px; top:-90px; border-radius:50%; background:var(--accent-glow); filter:blur(4px); pointer-events:none; }
        .section-heading > div:first-child { position:relative; z-index:1; min-width:0; }
        .section-heading h2 { font-size:clamp(18px,2.3vw,22px); letter-spacing:-.6px; }
        .section-heading p { font-size:12px; line-height:1.5; max-width:580px; }
        .section-icon { position:relative; z-index:1; width:48px; height:48px; border-radius:15px; font-size:22px; box-shadow:inset 0 1px rgba(255,255,255,.07); }
        .periods { gap:5px; padding:5px; margin-bottom:17px; border-radius:14px; background:rgba(15,22,18,.9); }
        .period { min-height:38px; display:flex; align-items:center; justify-content:center; padding:8px 6px; font-size:12px; }
        .period.active { background:var(--accent-soft); box-shadow:inset 0 0 0 1px var(--accent-line); }
        #grid-sales, #grid-milk { grid-template-columns:repeat(3,minmax(0,1fr)); gap:13px; }
        #grid-sales .card, #grid-milk .card { min-height:100%; border-radius:18px; padding:16px; }
        #grid-sales .card:last-child:nth-child(odd), #grid-milk .card:last-child:nth-child(odd) { grid-column:auto; width:100%; justify-self:stretch; }
        .gen-card, .milk-card { box-shadow:0 12px 28px rgba(0,0,0,.18), inset 0 1px rgba(255,255,255,.035); }
        .gen-head, .milk-card-head { gap:10px; }
        .gen-head .avatar-box, .milk-card-head .avatar-box { width:46px; height:46px; }
        .name { font-size:14px; }
        .gen-value { margin:15px 0 13px; }
        .gen-value strong, .milk-score strong { font-size:clamp(25px,3vw,34px); letter-spacing:-1.2px; }
        .gen-quote { border-radius:12px; padding:11px 12px; background:rgba(255,255,255,.045); }
        .gen-quote button { border-radius:9px; }
        .chart-container { height:360px; padding:18px 16px 14px; border-radius:19px; background:linear-gradient(145deg,#17221b,#111813); }
        .chart-data-list { grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; }
        .chart-data-item { padding:10px 11px; border-radius:11px; }
        .calendar-weekdays { gap:8px; padding:0 14px 10px; font-size:11px; }
        .calendar-grid { gap:8px; padding:15px; border-radius:19px; }
        .calendar-cell { border-radius:12px; }
        #calendar-title { margin-bottom:15px !important; }
        .log-summary { gap:10px; }
        .log-kpi { border-radius:15px; padding:14px; }
        .log-toolbar { gap:9px; }
        .log-control { min-height:43px; border-radius:11px; }
        .log-table-wrap { border-radius:16px; }
        .footer { max-width:1120px; }
        button, .tab, .period, .log-control { -webkit-tap-highlight-color:transparent; }
        button:focus-visible, .tab:focus-visible, .period:focus-visible, input:focus-visible, select:focus-visible { outline:2px solid var(--accent,#42e995); outline-offset:3px; }
        @media (min-width: 1100px) {
            #grid-sales, #grid-milk { grid-template-columns:repeat(4,minmax(0,1fr)); }
        }
        @media (max-width: 760px) {
            body { padding:14px 12px 28px; }
            #main-screen { max-width:680px; }
            #grid-sales, #grid-milk { grid-template-columns:repeat(2,minmax(0,1fr)); }
            .chart-data-list { grid-template-columns:repeat(3,minmax(0,1fr)); }
            .section-heading { min-height:84px; padding:16px 17px; }
            .tabs { top:5px; }
        }
        @media (max-width: 520px) {
            body { padding:10px 10px 24px; }
            .top-bar { padding:15px 16px; border-radius:17px; margin-bottom:11px; }
            .tabs { grid-template-columns:repeat(3,minmax(0,1fr)); gap:5px; padding:5px; margin-bottom:16px; border-radius:15px; }
            .tab { min-height:43px; flex-direction:row; font-size:11px; padding:9px 4px; }
            .section-heading { min-height:78px; padding:14px 15px; margin-bottom:14px; border-radius:16px; }
            .section-heading h2 { font-size:17px; }
            .section-heading p { font-size:10px; max-width:260px; }
            .section-icon { width:41px; height:41px; border-radius:13px; font-size:19px; }
            #grid-sales, #grid-milk { gap:9px; }
            #grid-sales .card, #grid-milk .card { padding:12px; border-radius:15px; }
            .gen-head .avatar-box, .milk-card-head .avatar-box { width:38px; height:38px; }
            .name { font-size:12px; }
            .gen-value strong, .milk-score strong { font-size:25px; }
            .chart-container { height:285px; padding:12px 8px 9px; border-radius:15px; }
            .chart-data-list { grid-template-columns:repeat(2,minmax(0,1fr)); }
            .calendar-grid { gap:5px; padding:9px; }
            .calendar-weekdays { gap:5px; padding:0 9px 8px; }
            .calendar-cell { border-radius:8px; }
            .log-summary { grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px; }
            .log-kpi { min-width:0; padding:10px 8px; }
            .log-kpi span { font-size:9px; }
            .log-kpi strong { font-size:15px; overflow-wrap:anywhere; }
        }
        @media (max-width: 370px) {
            .tab { flex-direction:column; gap:3px; font-size:10px; }
            #grid-sales, #grid-milk { grid-template-columns:1fr; }
            .chart-data-list { grid-template-columns:1fr 1fr; }
            .section-heading p { max-width:220px; }
        }
        @media (min-width: 700px) {
            #login-screen { margin-top:clamp(45px,10vh,110px); }
        }
        @media (max-width: 430px) {
            #login-screen { margin:clamp(20px,6vh,48px) auto 0; padding:26px 20px 19px; border-radius:22px; }
            .login-mark { width:50px; height:50px; }
            .login-box h2 { font-size:23px; }
        }

    </style>
</head>
<body>
    <div id="login-screen" class="login-box">
        <div class="login-mark"><span>AB</span><i></i></div>
        <div class="login-heading">
            <div class="login-kicker">ЛИЧНЫЙ КАБИНЕТ</div>
            <h2>ABDU Manager</h2>
            <p>Вход в панель статистики</p>
        </div>
        <label class="login-label" for="login-id">Telegram ID</label>
        <input type="number" id="login-id" placeholder="Например, 123456789" inputmode="numeric" />
        <button class="login-primary" onclick="sendCode()"><span>Получить код</span><b>→</b></button>
        <div class="login-code-wrap">
            <label class="login-label" for="login-code">Код подтверждения</label>
            <input type="text" id="login-code" placeholder="Введи код из личных сообщений" style="display: none;" autocomplete="one-time-code" />
        </div>
        <button class="login-secondary" onclick="verifyCode()" style="display: none;">Подтвердить вход <span>→</span></button>
        <div id="login-status" role="status" aria-live="polite"></div>
        <div class="login-foot"><span class="login-lock">⌑</span> Защищённый вход через Telegram</div>
    </div>

    <div id="main-screen">
        <div class="top-bar">
            <div class="brand">
                <div class="title">ABDU Manager</div>
                <div class="subtitle">Панель статистики</div>
            </div>
        </div>
        
        <div class="tabs">
            <div class="tab active" onclick="showSection('sales', this)">💎 Генки</div>
            <div class="tab" onclick="showSection('tasks', this)">📦 Таски</div>
            <div class="tab" onclick="showSection('milk', this)">🥛 Дойка</div>
            <div class="tab" onclick="showSection('graph', this)">📈 График</div>
            <div class="tab" onclick="showSection('calendar', this)">📅 Календарь</div>
            <div class="tab" onclick="showSection('logs', this)">📑 Логи</div>
        </div>
        
        <div id="section-sales" class="section active">
            <div class="section-heading"><div><h2>💎 Генерации</h2><p>Рейтинг пользователей по количеству генераций</p></div><div class="section-icon">💎</div></div>
            <div class="periods" id="periods-sales">
                <div class="period active" onclick="setPeriod('today', this)">Сутки</div>
                <div class="period" onclick="setPeriod('week', this)">Неделя</div>
                <div class="period" onclick="setPeriod('month', this)">Месяц</div>
                <div class="period" onclick="setPeriod('all', this)">Всё</div>
            </div>
            <div id="grid-sales" class="grid"></div>
        </div>
        
        <div id="section-tasks" class="section" style="display: none;">
            <div class="section-heading"><div><h2>📦 Таски</h2><p>Ресурсы, количество и заработок за период</p></div><div class="section-icon">📦</div></div>
            <div class="periods" id="periods-tasks">
                <div class="period active" onclick="setPeriod('today', this)">Сутки</div>
                <div class="period" onclick="setPeriod('week', this)">Неделя</div>
                <div class="period" onclick="setPeriod('month', this)">Месяц</div>
                <div class="period" onclick="setPeriod('all', this)">Всё</div>
            </div>
            <div id="grid-tasks" class="grid"></div>
        </div>

        <div id="section-milk" class="section" style="display: none;">
            <div class="section-heading"><div><h2>🥛 Дойка</h2><p>Рейтинг дояров</p></div><div class="section-icon">🥛</div></div>
            <div class="periods" id="periods-milk">
                <div class="period active" onclick="setPeriod('today', this)">Сутки</div>
                <div class="period" onclick="setPeriod('week', this)">Неделя</div>
                <div class="period" onclick="setPeriod('month', this)">Месяц</div>
                <div class="period" onclick="setPeriod('all', this)">Всё</div>
            </div>
            <div id="grid-milk" class="grid"></div>
        </div>

        <div id="section-graph" class="section" style="display: none;">
            <div class="section-heading"><div><h2>📈 График</h2><p>Динамика генераций по времени</p></div><div class="section-icon">📈</div></div>
            <div class="graph-types" id="graph-types">
                <button class="graph-type active" data-kind="sales" onclick="setGraphType('sales', this)">💎 Генки</button>
                <button class="graph-type" data-kind="milk" onclick="setGraphType('milk', this)">🥛 Дойка</button>
                <button class="graph-type" data-kind="tasks" onclick="setGraphType('tasks', this)">📦 Таски</button>
            </div>
            <div class="periods" id="periods-graph">
                <div class="period active" onclick="drawChart('today', this)">Сутки</div>
                <div class="period" onclick="drawChart('week', this)">Неделя</div>
                <div class="period" onclick="drawChart('month', this)">Месяц</div>
            </div>
            <div class="chart-container"><canvas id="myChart"></canvas></div>
            <div class="chart-data-list" id="chart-data-list" aria-label="Точные значения графика"></div>
        </div>

        <div id="section-calendar" class="section" style="display: none;">
            <div class="section-heading"><div><h2>📅 Календарь</h2><p>Количество генераций по дням</p></div><div class="section-icon">📅</div></div>
            <div class="periods" id="periods-calendar">
                <div class="period active" onclick="drawCalendar(0, this)">Текущий</div>
            </div>
            <div id="calendar-title" style="text-align: center; font-size: 18px; font-weight: bold; margin-bottom: 10px;"></div>
            <div class="calendar-weekdays"><div>Пн</div><div>Вт</div><div>Ср</div><div>Чт</div><div>Пт</div><div>Сб</div><div>Вс</div></div>
            <div id="calendar-grid" class="calendar-grid"></div>
        </div>

        <div id="section-logs" class="section" style="display:none;">
            <div class="section-heading"><div><h2>📑 Подробные логи</h2><p>Журнал операций в табличном формате</p></div><div class="section-icon">📑</div></div>
            <div class="log-summary" id="log-summary"></div>
            <div class="log-toolbar">
                <select id="log-type-filter" class="log-control" onchange="renderLogs()">
                    <option value="all">Все операции</option><option value="sales">Генки</option><option value="milk">Дойка</option><option value="tasks">Таски</option>
                </select>
                <select id="log-period-filter" class="log-control" onchange="renderLogs()">
                    <option value="today">Сегодня</option><option value="week" selected>7 дней</option><option value="month">30 дней</option><option value="all">Всё время</option>
                </select>
                <input id="log-search" class="log-control" placeholder="Поиск по имени / ресурсу" oninput="renderLogs()" style="flex:1;min-width:150px;">
            </div>
            <div class="log-table-wrap"><table class="log-table"><thead><tr><th>Дата и время</th><th>Тип</th><th>Участник</th><th>Действие / ресурс</th><th>Количество</th><th>Муни</th></tr></thead><tbody id="log-table-body"></tbody></table></div>
            <div id="log-count" style="padding:10px 2px;color:var(--muted);font-size:10px;"></div>
        </div>
        <div class="footer">Мур-мур, вы лучшие! 🐾</div>
        <button id="logout-btn" onclick="logout()">Выйти</button>
    </div>

    <script>
        const API_URL = "https://moreover-your-all-ash.trycloudflare.com";
        let isAuthorized = false;
        let userId = null;
        let data = {};
        let currentSection = 'sales';
        let currentPeriod = 'today';
        let chart = null;
        let currentGraphType = 'sales';
        let currentGraphPeriod = 'today';

        const savedToken = localStorage.getItem('auth_token');
        if (savedToken) {
            userId = parseInt(savedToken);
            isAuthorized = true;
            showMainScreen();
            loadData();
        }

        async function sendCode() {
            const id = document.getElementById('login-id').value;
            if (!id) return alert('Введи ID');
            document.getElementById('login-status').textContent = 'Отправляю...';
            try {
                const res = await fetch(API_URL + '/api/send_code', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({user_id: parseInt(id)})
                });
                const json = await res.json();
                if (res.ok) {
                    document.getElementById('login-code').style.display = 'block';
                    document.querySelector('.login-code-wrap').style.display = 'flex';
                    document.querySelectorAll('.login-box button')[1].style.display = 'block';
                    document.getElementById('login-status').textContent = 'Код отправлен в ЛС';
                    userId = parseInt(id);
                } else {
                    document.getElementById('login-status').textContent = json.detail || 'Ошибка';
                }
            } catch (e) {
                document.getElementById('login-status').textContent = 'Сервер недоступен';
            }
        }

        async function verifyCode() {
            const code = document.getElementById('login-code').value;
            if (!code) return alert('Введи код');
            document.getElementById('login-status').textContent = 'Проверяю...';
            try {
                const res = await fetch(API_URL + '/api/verify_code', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({user_id: userId, code: code})
                });
                const json = await res.json();
                if (res.ok) {
                    localStorage.setItem('auth_token', json.token);
                    isAuthorized = true;
                    showMainScreen();
                    loadData();
                } else {
                    document.getElementById('login-status').textContent = json.detail || 'Ошибка';
                }
            } catch (e) {
                document.getElementById('login-status').textContent = 'Сервер недоступен';
            }
        }

        function showMainScreen() {
            document.getElementById('login-screen').style.display = 'none';
            document.getElementById('main-screen').style.display = 'block';
            document.getElementById('main-screen').dataset.theme = 'sales';
        }

        function logout() {
            localStorage.removeItem('auth_token');
            location.reload();
        }

        async function loadData() {
            try {
                const res = await fetch('data.json?t=' + Date.now());
                data = await res.json();
                render();
                if (currentSection === 'graph') drawChart(currentGraphPeriod);
                if (currentSection === 'calendar') drawCalendar(0);
            } catch (e) { console.error(e); }
        }

        function showSection(s, el) {
            currentSection = s;
            const theme = s === 'sales' ? 'sales' : s === 'milk' ? 'milk' : s === 'tasks' ? 'tasks' : s === 'graph' ? `graph-${currentGraphType}` : 'sales';
            document.getElementById('main-screen').dataset.theme = theme;
            document.querySelectorAll('.section').forEach(sec => sec.style.display = 'none');
            document.getElementById('section-' + s).style.display = 'block';
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            el.classList.add('active');
            render();
            if (s === 'graph') drawChart(currentPeriod);
            if (s === 'calendar') drawCalendar(0);
            if (s === 'logs') renderLogs();
        }

        function setPeriod(p, el) {
            currentPeriod = p;
            el.parentElement.querySelectorAll('.period').forEach(per => per.classList.remove('active'));
            el.classList.add('active');
            render();
        }

        function render() {
            if (currentSection === 'tasks') renderTasks();
            else if (currentSection === 'sales' || currentSection === 'milk') renderCards();
        }

        function renderCards() {
            const grid = document.getElementById('grid-' + currentSection);
            if (!data[currentPeriod]) { grid.innerHTML = '<div class="empty-state">Нет данных за выбранный период</div>'; return; }
            const items = data[currentPeriod][currentSection] || [];
            if (!items.length) { grid.innerHTML = '<div class="empty-state">Пока нет данных за этот период</div>'; return; }
            let html = '';
            const isMilk = currentSection === 'milk';
            const unit = isMilk ? 'доек' : 'ген.';
            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                const value = Number(item.val || 0).toLocaleString('ru-RU');
                const quoteKey = `abdu_quote_${item.uid || item.name}`;
                const savedQuote = localStorage.getItem(quoteKey);
                const quote = savedQuote !== null ? savedQuote : (item.quote || 'Своя цитата ещё не добавлена');
                if (isMilk) {
                    html += `<article class="card milk-card milk-rank-${Math.min(i + 1, 3)}" style="animation-delay:${Math.min(i, 8) * 55}ms">
                        <div class="milk-card-head">
                            <span class="milk-rank">${i === 0 ? '👑' : `#${i + 1}`}</span>
                            <div class="avatar-box"><img src="${item.ava}" alt=""></div>
                            <div class="info"><div class="name">${item.name}</div><div class="milk-caption">УЧАСТНИК ДОЙКИ</div></div>
                        </div>
                        <div class="milk-score"><strong>${value}</strong><span>доек</span></div>
                        <div class="milk-progress"><i style="width:${Math.max(8, Number(item.val || 0) / Math.max(1, Number(items[0].val || 1)) * 100)}%"></i></div>
                    </article>`;
                } else {
                    html += `<article class="card gen-card" style="animation-delay:${Math.min(i, 8) * 55}ms">
                        <div class="gen-head">
                            <span class="gen-rank ${i === 0 ? 'first' : ''}">${i === 0 ? '👑' : `#${i + 1}`}</span>
                            <div class="avatar-box"><img src="${item.ava}" alt=""></div>
                            <div class="gen-user"><div class="name">${item.name}</div><small>УЧАСТНИК · ГЕНЕРАЦИИ</small></div>
                        </div>
                        <div class="gen-value"><strong>${value}</strong><span>${unit}</span></div>
                        <div class="gen-quote"><span class="quote-text">${escapeHtml(quote)}</span><button onclick="editQuote('${String(item.uid || item.name).replace(/'/g, "\\'")}','${String(item.name).replace(/'/g, "\\'")}')">Изменить</button></div>
                    </article>`;
                }
            }
            grid.innerHTML = html;
        }

        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
        }

        function editQuote(id, name) {
            const key = `abdu_quote_${id}`;
            const current = localStorage.getItem(key) || '';
            const next = prompt(`Своя цитата для ${name}:`, current);
            if (next === null) return;
            const clean = next.trim().slice(0, 180);
            if (!clean) localStorage.removeItem(key);
            else localStorage.setItem(key, clean);
            renderCards();
        }

        const TASK_RESOURCE_NAMES = {
            "🥛": "Молоко", "🥪": "Бутер", "🧃": "Дерьмосок", "💊": "Таблетка",
            "🌿": "Травка", "🍗": "Нагетс", "🥨": "Крендель", "🧵": "Нить",
            "🌰": "Орех", "💩": "Говно", "🥚": "Яйцо", "🍺": "Пиво",
            "🥫": "Томат", "🍳": "Яичница", "🌸": "Цветик", "🍕": "Сыропицца"
        };

        function renderTasks() {
            const grid = document.getElementById('grid-tasks');
            if (!data[currentPeriod]) { grid.innerHTML = '<div class="empty-state">Нет данных за выбранный период</div>'; return; }
            const items = data[currentPeriod].tasks || [];
            if (!items.length) { grid.innerHTML = '<div class="empty-state">Пока нет выполненных тасков за этот период</div>'; return; }
            let html = '';
            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                const emoji = String(item.name || '📦');
                const resourceName = TASK_RESOURCE_NAMES[emoji] || 'Неизвестный ресурс';
                const amount = Number(item.amount || 0).toLocaleString('ru-RU');
                const money = Number(item.money || 0).toLocaleString('ru-RU');
                html += `<article class="card task-card" style="--task-accent:#ff9b42;--task-accent-soft:rgba(255,155,66,.12);--task-accent-line:rgba(255,155,66,.24);animation-delay:${Math.min(i, 8) * 45}ms">
                    <div class="task-card-top">
                        <div class="task-emoji">${emoji}</div>
                        <div class="task-title-wrap">
                            <div class="task-index">РЕСУРС · ${String(i + 1).padStart(2, '0')}</div>
                            <div class="task-name">${resourceName}</div>
                        </div>
                        <div class="task-kind">ТАСК</div>
                    </div>
                    <div class="task-main-value"><strong>${amount}</strong><span>единиц потрачено</span></div>
                    <div class="task-card-bottom">
                        <span class="task-money-label">Заработано</span>
                        <strong class="task-money-value">${money} <small>💰</small></strong>
                    </div>
                </article>`;
            }
            grid.innerHTML = html;
        }

        function setGraphType(kind, el) {
            currentGraphType = kind;
            document.querySelectorAll('#graph-types .graph-type').forEach(button => button.classList.toggle('active', button === el));
            const theme = kind === 'sales' ? 'sales' : `graph-${kind}`;
            document.getElementById('main-screen').dataset.theme = theme;
            const descriptions = {
                sales: 'Динамика генераций по времени',
                milk: 'Динамика доек по времени',
                tasks: 'Заработанные муни за выполнение тасков'
            };
            document.querySelector('#section-graph .section-heading p').textContent = descriptions[kind];
            drawChart(currentGraphPeriod);
        }

        function getGraphData(period, kind) {
            const bucket = data[period] || {};
            if (bucket.graphs && bucket.graphs[kind]) return bucket.graphs[kind];
            // Backward compatibility with older data.json: it only contains the sales graph.
            if (kind === 'sales' && bucket.graph) return bucket.graph;
            return null;
        }

        function drawChart(period, el) {
            if (el) {
                currentGraphPeriod = period;
                document.querySelectorAll('#periods-graph .period').forEach(p => p.classList.remove('active'));
                el.classList.add('active');
            }
            const graph = getGraphData(period, currentGraphType);
            const canvas = document.getElementById('myChart');
            const list = document.getElementById('chart-data-list');
            if (chart) { chart.destroy(); chart = null; }
            if (!graph) {
                list.innerHTML = '<div class="empty-state">Для этого графика пока нет данных. Обнови data.json генератором сайта.</div>';
                return;
            }

            const labels = graph.labels || [];
            const values = graph.values || [];
            if (!labels.length || !values.length) {
                list.innerHTML = '<div class="empty-state">Нет данных за выбранный период</div>';
                return;
            }
            const palette = {
                sales: { label: 'Генерации', color: '#00e676', fill: 'rgba(0,230,118,.80)', unit: 'ген.' },
                milk: { label: 'Дойки', color: '#48a9ff', fill: 'rgba(72,169,255,.78)', unit: 'доек' },
                tasks: { label: 'Заработано', color: '#ff9b42', fill: 'rgba(255,155,66,.80)', unit: 'муни' }
            }[currentGraphType];
            const fmt = value => Number(value || 0).toLocaleString('ru-RU');

            list.innerHTML = `<div class="chart-data-heading"><span>Значения по дням</span><span>${palette.unit}</span></div>` + labels.map((label, i) =>
                `<div class="chart-data-item"><span>${label}</span><strong>${fmt(values[i])}</strong></div>`
            ).join('');

            chart = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels,
                    datasets: [{
                        label: palette.label,
                        data: values,
                        backgroundColor: palette.fill,
                        hoverBackgroundColor: palette.color,
                        borderColor: palette.color,
                        borderWidth: 1,
                        borderRadius: 6,
                        borderSkipped: false,
                        maxBarThickness: 30,
                        categoryPercentage: .72,
                        barPercentage: .82
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: { padding: { top: 8, right: 5, left: 1, bottom: 0 } },
                    animation: { duration: 720, easing: 'easeOutQuart' },
                    resizeDelay: 120,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            displayColors: false,
                            backgroundColor: '#202923',
                            titleColor: '#f3f7f4',
                            bodyColor: palette.color,
                            padding: 11,
                            callbacks: {
                                title: items => items[0]?.label || '',
                                label: context => `${palette.label}: ${fmt(context.raw)} ${palette.unit}`
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#9aa69e', maxRotation: 0, minRotation: 0, autoSkip: true, autoSkipPadding: 12, maxTicksLimit: 6, font: { size: 10, weight: '600' } },
                            border: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            grace: '8%',
                            grid: { color: 'rgba(255,255,255,.07)' },
                            ticks: { color: '#89958d', precision: 0, maxTicksLimit: 5, callback: value => fmt(value), font: { size: 10 } },
                            border: { display: false }
                        }
                    }
                }
            });
        }

        function drawCalendar(offset, el) {
            if (el) {
                document.querySelectorAll('#periods-calendar .period').forEach(p => p.classList.remove('active'));
                el.classList.add('active');
            }
            if (!data["today"] || !data["today"].calendar) return;
            
            const cal = data["today"].calendar;
            document.getElementById('calendar-title').textContent = cal.title;
            const grid = document.getElementById('calendar-grid');
            grid.innerHTML = '';
            
            cal.days.forEach(d => {
                const cell = document.createElement('div');
                cell.className = 'calendar-cell ' + (d.day ? 'c-' + (d.color || 'gray') : 'empty');
                if (d.day) {
                    const dayNumber = document.createElement('span');
                    dayNumber.className = 'day-number';
                    dayNumber.textContent = d.day;
                    const dayValue = document.createElement('span');
                    dayValue.className = 'day-value';
                    dayValue.textContent = Number(d.count || 0).toLocaleString('ru-RU');
                    if (d.is_today) cell.classList.add('is-today');
                    cell.title = `${d.day}: ${Number(d.count || 0).toLocaleString('ru-RU')} генераций`;
                    cell.append(dayNumber, dayValue);
                }
                grid.appendChild(cell);
            });
        }

        function getCompliment(name) {
            const comps = ["Гений генераций 🧠", "Машина мощности 🚀", "Король скорости ⚡", "Мастер стратегии ♟️", "Звезда чата ⭐", "Легенда генераций 🔥", "Просто космос 🌌", "Неудержимый поток 💥", "Топ по мозгам 🧠"];
            let hash = 0;
            for (let i = 0; i < name.length; i++) hash = ((hash << 5) - hash) + name.charCodeAt(i);
            return comps[Math.abs(hash) % comps.length];
        }

        setInterval(() => { if (isAuthorized) loadData(); }, 60000);

        function renderLogs() {
            const body = document.getElementById('log-table-body');
            if (!body) return;
            const type = document.getElementById('log-type-filter')?.value || 'all';
            const period = document.getElementById('log-period-filter')?.value || 'week';
            const search = (document.getElementById('log-search')?.value || '').toLowerCase().trim();
            const source = Array.isArray(data.logs) ? data.logs : [];
            const cutoff = period === 'today' ? new Date(new Date().setHours(0,0,0,0)) :
                period === 'week' ? new Date(Date.now() - 7*86400000) :
                period === 'month' ? new Date(Date.now() - 30*86400000) : null;
            const rows = source.filter(row => {
                if (type !== 'all' && row.type !== type) return false;
                if (cutoff && new Date(row.ts) < cutoff) return false;
                return !search || `${row.name} ${row.detail} ${row.typeLabel}`.toLowerCase().includes(search);
            });
            const all = source.filter(row => !cutoff || new Date(row.ts) >= cutoff);
            const totals = {
                sales: all.filter(x=>x.type==='sales').reduce((a,x)=>a+Number(x.amount||0),0),
                milk: all.filter(x=>x.type==='milk').reduce((a,x)=>a+Number(x.amount||0),0),
                money: all.filter(x=>x.type==='tasks').reduce((a,x)=>a+Number(x.money||0),0)
            };
            document.getElementById('log-summary').innerHTML = `
                <div class="log-kpi"><span>💎 Генераций</span><strong>${totals.sales.toLocaleString('ru-RU')}</strong></div>
                <div class="log-kpi"><span>🥛 Доек</span><strong>${totals.milk.toLocaleString('ru-RU')}</strong></div>
                <div class="log-kpi"><span>🪙 Муни</span><strong>${totals.money.toLocaleString('ru-RU')}</strong></div>`;
            if (!rows.length) body.innerHTML = '<tr><td colspan="6" class="log-empty">Операций не найдено</td></tr>';
            else body.innerHTML = rows.slice(0,500).map(row => {
                const date = new Date(row.ts);
                const dateText = isNaN(date) ? row.ts : date.toLocaleString('ru-RU',{day:'2-digit',month:'2-digit',year:'2-digit',hour:'2-digit',minute:'2-digit'});
                const kind = row.type === 'sales' ? 'sales' : row.type === 'milk' ? 'milk' : 'tasks';
                const label = row.typeLabel || (kind==='sales'?'💎 Генки':kind==='milk'?'🥛 Дойка':'📦 Таски');
                return `<tr><td>${escapeHtml(dateText)}</td><td><span class="log-type ${kind}">${escapeHtml(label)}</span></td><td>${escapeHtml(row.name || '—')}</td><td>${escapeHtml(row.detail || '—')}</td><td>${Number(row.amount||0).toLocaleString('ru-RU')}</td><td class="log-positive">${Number(row.money||0) ? Number(row.money).toLocaleString('ru-RU') : '—'}</td></tr>`;
            }).join('');
            document.getElementById('log-count').textContent = `Показано ${Math.min(rows.length,500)} из ${rows.length} операций`;
        }

    </script>
</body>
</html>
